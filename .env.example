# Freepik
FREEPIK_API_KEY=

# Google AI Studio (GEMINI_API_KEY is the preferred name)
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=

# Google Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Use Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS, or
# provide the service-account JSON inline in one of these variables:
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLOUD_CREDENTIALS=

# Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Optional PostgreSQL / Neon persistence for task history and generated images
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Temporary public hosting for input media
CLOUDINARY_URL=
# Or configure the three values below instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional local runtime storage directory.
# Required persistent storage for the single-admin deployment. Not supported on ephemeral Vercel filesystems.
# OPEN_HIGGSFIELD_STORAGE_DIR=/absolute/path/to/open-higgsfield-data

# Create the administrator and add provider API keys in the browser.
# Required in production: exact public origin, without trailing slash (EasyPanel HTTPS domain).
# OPEN_HIGGSFIELD_APP_ORIGIN=https://studio.example.com
# Optional one-time installation token, at least 24 characters. Otherwise generated at startup.
# OPEN_HIGGSFIELD_SETUP_TOKEN=
# Legacy migration ONLY: retain the original values until existing connections are saved again.
# OPEN_HIGGSFIELD_ADMIN_PASSWORD=
# OPEN_HIGGSFIELD_CREDENTIALS_KEY=

# Optional provider defaults. The admin panel can store encrypted connections instead.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Open-Higgsfield

HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai

API_MARKET_API_KEY=
API_MARKET_BASE_URL=https://prod.api.market/api/mcp
API_MARKET_WORKSPACE=
API_MARKET_SLUG=
API_MARKET_MEDIA_TYPE=image
API_MARKET_TOOL_NAME=
# Workflows: optional standard PostgreSQL connection (separate from legacy Neon DATABASE_URL).
# Leave empty for local SQLite. Never change backends without migrating/backing up data.
WORKFLOWS_DATABASE_URL=
# Set to 1 on the web service ONLY when a separate workflow worker is running.
WORKFLOWS_EXTERNAL_WORKER=0
